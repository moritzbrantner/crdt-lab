{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "test"]
  },
  "requiredCapabilities": ["format:check", "lint", "test"],
  "capabilityCommands": {
    ".": {
      "format:check": ["cargo", "fmt", "--all", "--", "--check"],
      "lint": [
        "cargo",
        "clippy",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ],
      "test": ["cargo", "test", "--all-targets", "--all-features"]
    }
  }
}
