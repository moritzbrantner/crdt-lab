{
  "name": "concurrent move of the same item",
  "replicas": ["alice", "bob"],
  "steps": [
    {"type":"local","id":"insert-a","replica":"alice","action":{"type":"insert","index":0,"item":"a","value":"A"}},
    {"type":"local","id":"insert-b","replica":"alice","action":{"type":"insert","index":1,"item":"b","value":"B"}},
    {"type":"local","id":"insert-c","replica":"alice","action":{"type":"insert","index":2,"item":"c","value":"C"}},
    {"type":"deliver","operation":"insert-a","to":"bob"},
    {"type":"deliver","operation":"insert-b","to":"bob"},
    {"type":"deliver","operation":"insert-c","to":"bob"},
    {"type":"link","left":"alice","right":"bob","connected":false},
    {"type":"local","id":"alice-move-c","replica":"alice","action":{"type":"move","item":"c","target_index":0}},
    {"type":"local","id":"bob-move-c","replica":"bob","action":{"type":"move","item":"c","target_index":2}},
    {"type":"link","left":"alice","right":"bob","connected":true},
    {"type":"deliver","operation":"bob-move-c","to":"alice"},
    {"type":"deliver","operation":"alice-move-c","to":"bob"},
    {"type":"assert","assertion":{"type":"equivalent","replicas":["alice","bob"]}},
    {"type":"assert","assertion":{"type":"visible_order","replica":"alice","items":["a","b","c"]}},
    {"type":"assert","assertion":{"type":"visible_order","replica":"bob","items":["a","b","c"]}}
  ]
}
